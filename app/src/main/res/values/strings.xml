    <string name="detail_title">Detalle</string>
    <string name="action_back">Volver</string>
    <string name="detail_label_country_code">Código de país</string>
    <string name="detail_label_province">Estado / Provincia</string>
    <string name="detail_label_domains">Dominios web oficiales</string>
    <string name="detail_label_website">Sitio web</string>
    <string name="detail_not_available">No especificado</string>
    <string name="action_open_website">Visitar sitio web</string>
    <string name="action_search_web">Buscar en Google</string>
