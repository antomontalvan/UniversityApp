<?xml version="1.0" encoding="utf-8"?>
<!--
    Main screen: gradient hero header (brand, headline and search box) + results list.
    The ProgressBar and the message block (idle / empty / error) are centered
    below the header and toggled by MainActivity according to the UI state.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".ui.main.MainActivity">

    <!-- Hero header. Its top padding is increased at runtime by the status bar height -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_hero_gradient"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Brand row: logo + app name -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_icon_circle"
                android:backgroundTint="@color/primary"
                android:importantForAccessibility="no"
                android:padding="8dp"
                android:src="@drawable/ic_school"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="sans-serif-black"
                android:text="@string/brand_name"
                android:textColor="@color/primary"
                android:textSize="20sp" />

        </LinearLayout>

        <!-- Two-color headline: dark first line, blue second line -->
        <TextView
            style="@style/HeroTitle"
            android:layout_marginTop="24dp"
            android:text="@string/hero_title_line1"
            android:textColor="@color/text_primary" />

        <TextView
            style="@style/HeroTitle"
            android:layout_marginTop="2dp"
            android:text="@string/hero_title_line2"
            android:textColor="@color/primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/hero_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- Pill-shaped search box -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSearch"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:boxBackgroundColor="@color/surface"
            app:boxCornerRadiusBottomEnd="28dp"
            app:boxCornerRadiusBottomStart="28dp"
            app:boxCornerRadiusTopEnd="28dp"
            app:boxCornerRadiusTopStart="28dp"
            app:boxStrokeColor="@color/primary"
            app:endIconMode="clear_text"
            app:hintEnabled="false"
            app:startIconDrawable="@drawable/ic_search"
            app:startIconTint="@color/primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCountrySearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch"
                android:inputType="textCapWords"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary" />

        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/tvResultsCount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:fontFamily="sans-serif-black"
        android:textColor="@color/text_primary"
        android:textSize="17sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader"
        tools:text="126 universidades encontradas"
        tools:visibility="visible" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvUniversities"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvResultsCount"
        tools:listitem="@layout/item_university" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/primary"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader" />

    <!-- Message block used for the Idle, Empty and Error states -->
    <LinearLayout
        android:id="@+id/layoutMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader">

        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:background="@drawable/bg_icon_circle"
            android:backgroundTint="@color/primary_light"
            android:importantForAccessibility="no"
            android:padding="22dp"
            android:src="@drawable/ic_university"
            app:tint="@color/primary" />

        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            tools:text="@string/message_idle" />

        <!-- Quick suggestions: tapping a chip fills the search box -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupSuggestions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:chipSpacingHorizontal="8dp"
            app:singleLine="false">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipArgentina"
                style="@style/SuggestionChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/suggestion_argentina" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSpain"
                style="@style/SuggestionChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/suggestion_spain" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipUnitedStates"
                style="@style/SuggestionChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/suggestion_united_states" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipJapan"
                style="@style/SuggestionChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/suggestion_japan" />

        </com.google.android.material.chip.ChipGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetry"
            style="@style/PillButton"
            android:layout_width="wrap_content"
            android:layout_marginTop="20dp"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:text="@string/action_retry"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
